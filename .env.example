DATABASE_URL=postgresql://postgres:dev@localhost:5434/tasks
LEETCODE_USERNAME=

# From your Clerk dashboard (clerk.com) — required once auth is wired in.
# Publishable key is safe client-side; secret key is server-only, never commit it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The email you sign in with — required by the MCP server and sync:leetcode
# only, never by the web app itself (Clerk resolves that per-request).
EMBER_OWNER_EMAIL=

# One fixed IANA timezone name (e.g. America/New_York) for all "today"/"this
# week" boundary math across the whole deployment — required so a laptop
# running this locally and a server running it elsewhere agree on what day
# it is. Must also be set in the deploy target's environment variables.
NEXT_PUBLIC_EMBER_TIMEZONE=
